FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro-0813

# Web retrieval (search_web). Removing these produces an honest unavailable state.
# Prefer Tavily when you have a key. Otherwise any WEB_SEARCH_API_KEY enables DuckDuckGo HTML search.
TAVILY_API_KEY=
WEB_SEARCH_API_KEY=enabled
